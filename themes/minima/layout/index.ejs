<div class="hero-card">
  <button id="hamburgerBtn" class="hamburger-btn" type="button" aria-label="打开菜单" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  </button>
  <div class="hero-menu" id="heroMenu" hidden>
    <a href="<%- url_for('/archives/') %>" class="hero-menu-link">归档</a>
    <a href="<%- url_for('/about/') %>" class="hero-menu-link">关于</a>
    <button id="themeToggle" class="hero-menu-link theme-toggle-btn" type="button" aria-label="切换主题">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      <span>切换主题</span>
    </button>
  </div>
  <div class="hero-avatar-wrap">
    <img src="<%- url_for('/images/main.jpg') %>" alt="<%= theme.owner %>" class="about mb-3" width="150" height="150" decoding="async" fetchpriority="high">
  </div>
  <div class="home-hero-copy">
    <p class="eyebrow">PERSONAL NOTES</p>
    <h2 class="mb-2"><%= theme.owner %></h2>
    <p><%= theme.info %></p>
    <p><%= theme.desc %></p>
  </div>
</div>

<section class="home-section">
  <div class="section-heading-row">
    <h3>最近文章</h3>
    <a href="<%= config.root %>archives" class="interactive-link section-more">查看全部
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </a>
  </div>
  <div class="home-post-list">
    <% site.posts.sort('date', 'desc').limit(theme.max_post).forEach(function(post){ %>
    <div class="home-post-row">
      <div class="home-post-date">
        <time datetime="<%- date_xml(post.date) %>"><%- full_date(post.date, 'll') %></time>
      </div>
      <div class="home-post-title">
        <a href="<%- url_for(post.path) %>" class="interactive-link">
          <% if (post.title === '') { %>未命名<% } else { %><%- post.title %><% } %>
        </a>
      </div>
    </div>
    <% }) %>
  </div>
</section>
