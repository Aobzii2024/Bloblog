# ========================================
# Content Security Policy (CSP)
# Adapted for static blog deployment
# Works with Netlify / Vercel / Cloudflare Pages
# ========================================

/*
  # General pages & HTML
  - self only for docs, styles, scripts
  - jsdelivr allowed for MathJax CDN
  - unsafe-inline for styles (Hexo/EJS inline styles) and theme toggle
  - unsafe-hashes for View Transition API + keyboard shortcuts
  - nonce added dynamically by Hexo plugin (if installed)
*/

/*
Content-Security-Policy: default-src 'self';
  style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net;
  script-src 'self' 'unsafe-inline' 'unsafe-hashes' https://cdn.jsdelivr.net;
  img-src 'self' data: https:;
  font-src 'self' https://cdn.jsdelivr.net;
  connect-src 'self';
  frame-ancestors 'none';
  base-uri 'self';
  form-action 'none';
  object-src 'none';
  upgrade-insecure-requests;
  prefetch-src 'self';

# Service Worker — must NOT have CSP blocking it
/sw.js
  Cache-Control: no-cache, no-transform
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:;

# Static assets — long cache
/(*).js
  Cache-Control: public, max-age=31536000, immutable

/(*)\.(css|woff2|ttf|png|jpg|jpeg|gif|webp|svg|ico)
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — must-revalidate
/(*)
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=0, must-revalidate
